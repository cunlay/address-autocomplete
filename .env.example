PORT=3000

# HERE (https://platform.here.com) — Autosuggest API
HERE_API_KEY=

# Mapbox (https://account.mapbox.com) — Geocoding API
MAPBOX_ACCESS_TOKEN=

# LocationIQ (https://locationiq.com) — Autocomplete API
LOCATIONIQ_API_KEY=

# OpenCage (https://opencagedata.com)
OPENCAGE_API_KEY=

# Geoapify (https://www.geoapify.com)
GEOAPIFY_API_KEY=

# Pelias — hosted via geocode.earth (https://geocode.earth) by default.
# Leave PELIAS_API_KEY blank and set PELIAS_URL to point at a self-hosted
# Pelias instance instead if you run your own.
PELIAS_API_KEY=
# PELIAS_URL=https://your-pelias-instance.example.com/v1/autocomplete

# Photon (Komoot) requires no API key — the public instance
# (https://photon.komoot.io) is used by default. For production
# traffic, self-host Photon and point PHOTON_URL at your instance.
# PHOTON_URL=https://your-photon-instance.example.com/api/

# OpenStreetMap Nominatim requires no API key, but its usage policy
# (https://operations.osmfoundation.org/policies/nominatim/) requires a
# descriptive User-Agent and caps the public instance at ~1 req/sec —
# fine for light/dev use, not production autocomplete volume.
# NOMINATIM_USER_AGENT=your-app-name/1.0 (contact@yourdomain.com)
# NOMINATIM_EMAIL=contact@yourdomain.com
# NOMINATIM_URL=https://your-self-hosted-nominatim.example.com/search

# Cache tuning
CACHE_TTL_MS=300000
CACHE_MAX_SIZE=1000
MIN_QUERY_LENGTH=2

# Free-tier quota overrides. The server tracks request counts per provider
# and, once a provider hits its limit for the period, /api/autocomplete/auto
# automatically skips it in favor of the next configured provider. Defaults
# match each provider's published free tier — only set these if you're on a
# paid plan with a different ceiling, or a provider changes its plan.
# HERE_FREE_LIMIT=250000       # per calendar month
# MAPBOX_FREE_LIMIT=100000     # per calendar month
# LOCATIONIQ_FREE_LIMIT=5000   # per calendar day
# OPENCAGE_FREE_LIMIT=2500     # per calendar day
# GEOAPIFY_FREE_LIMIT=3000     # per calendar day
# PELIAS_FREE_LIMIT=           # unset = unmetered; set only if you want tracking
# (Photon's and Nominatim's public instances are keyless and unmetered —
# nothing to override; they're governed by rate limits, not quotas.)

# Persistent cache (Railway: add a Redis service and paste its URL here).
# Leave blank for the in-memory cache, which is fine for local development.
# REDIS_URL=redis://default:password@host:6379

# Developer alerts for third-party failures (emailed via Resend).
# Get an API key at https://resend.com. Don't commit real keys.
# RESEND_API_KEY=
# DEVELOPER_EMAIL=you@example.com
# ALERT_FROM_EMAIL=ErrandLocal Alerts <alerts@yourdomain.com>   # domain must be verified in Resend
# ALERT_WINDOW_MS=900000                                         # identical errors emailed at most once per 15 min
